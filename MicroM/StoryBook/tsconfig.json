{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [ "dom", "dom.iterable", "ESNext" ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [ "node", "vite/client" ],

    "baseUrl": ".",
    "paths": {
      "@mcurros2/microm": [ "../micromlib/src/index.ts" ],
      "client": [ "../micromlib/src/client" ],
      "react": [ "./node_modules/@types/react" ],
      "react/*": [ "./node_modules/@types/react/*" ],
      "react-dom": [ "./node_modules/@types/react-dom" ],
      "react-dom/*": [ "./node_modules/@types/react-dom/*" ],
      "@mantine/*": [ "./node_modules/@mantine/*" ],
      "@emotion/react": [ "./node_modules/@emotion/react" ],
      "@tabler/icons-react": [ "./node_modules/@tabler/icons-react" ]
    }
  },
  "include": [ "stories", ".storybook" ],
  "exclude": [ "node_modules", "storybook-static" ]
}
